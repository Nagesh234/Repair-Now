# ─── React Native — .gitignore ──────────────────────────────────────────────
# Keeps the repository clean by excluding generated, build, and OS artifacts.
# Applies to both client-rn and partner-rn projects.

# ─── Node.js ────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log
.yarn/

# ─── React Native Build Outputs ─────────────────────────────────────────────
# Android
android/app/build/
android/build/
android/.gradle/
android/local.properties
*.keystore
!debug.keystore

# iOS
ios/build/
ios/Pods/
ios/*.xcworkspace/
ios/*.xcodeproj/xcuserdata/
DerivedData/

# ─── Metro Bundler Cache ─────────────────────────────────────────────────────
.metro-health-check*
.metro_cache/

# ─── TypeScript Cache ────────────────────────────────────────────────────────
*.tsbuildinfo

# ─── Environment Variables ───────────────────────────────────────────────────
# NEVER commit .env — it may contain API base URLs or local config.
# Commit .env.example only.
.env
.env.local
.env.production

# ─── OS Artifacts ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Editor Artifacts ────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ─── Test Coverage ───────────────────────────────────────────────────────────
coverage/
