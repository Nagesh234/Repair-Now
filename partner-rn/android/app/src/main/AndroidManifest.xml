<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml — Repair Now Partner App
  ─────────────────────────────────────────────
  Google Play Policy compliance notes:
    • INTERNET, POST_NOTIFICATIONS, and LOCATION perms are declared.
    • Location is required for live tracking during en_route status.
    • Avatar upload uses the system Photo Picker (no READ_MEDIA_IMAGES needed on API 33+).
    • android:exported="true" on MainActivity (required for API 31+ with intent-filter).
    • FirebaseMessagingService exported="false" per FCM security requirements.
    • android:allowBackup="false" prevents session data leaking via ADB backup.
    • android:usesCleartextTraffic="false" enforces HTTPS-only connections.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ─── Permissions ─────────────────────────────────────────────── -->

    <!-- Required for all API calls to the backend -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required on Android 13+ (API 33) to display push notifications for new repair jobs -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Location permissions for real-time partner tracking during 'en_route' status.
        FINE_LOCATION provides GPS accuracy; COARSE_LOCATION is required as a base.
        FOREGROUND_SERVICE is needed to allow location updates while the app is visible.
        Both permissions require a runtime permission request (handled in LocationTracker.tsx).
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- ─── Application ─────────────────────────────────────────────── -->

    <application
        android:name=".MainApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">

        <!-- ─── Main Activity ──────────────────────────────────────── -->
        <!--
            android:exported="true" is REQUIRED when targeting API 31+
            for activities that declare an intent-filter.
        -->
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ─── Firebase Cloud Messaging Service ─────────────────── -->
        <!--
            Partners receive FCM notifications for new available repair jobs.
            android:exported="false" — triggered only by the Firebase SDK.
        -->
        <service
            android:name="io.invertase.firebase.messaging.ReactNativeFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
