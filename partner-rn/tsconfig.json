{
    "extends": "@react-native/typescript-config/tsconfig.json",
    "compilerOptions": {
        "target": "esnext",
        "lib": [
            "esnext"
        ],
        "allowJs": true,
        "jsx": "react-native",
        "noEmit": true,
        "isolatedModules": true,
        "strict": true,
        "resolveJsonModule": true,
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "src/*"
            ]
        }
    },
    "exclude": [
        "node_modules",
        "android",
        "ios",
        "**/*.config.js",
        "**/__tests__/**"
    ]
}