# ─── Repair Now Backend — Environment Variables ───────────────────────────────
# Copy this file to .env for local development. Never commit .env to git.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get from: Supabase → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# ─── Razorpay ─────────────────────────────────────────────────────────────────
# Get from: Razorpay Dashboard → Settings → API Keys
# Use TEST keys for dev, LIVE keys for production
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# ─── Gmail (for OTP and notifications) ────────────────────────────────────────
# Use your Gmail address and an App Password (NOT your login password)
# Generate App Password: myaccount.google.com/apppasswords
# (Enable 2FA first, then create an App Password for "Mail")
GMAIL_USER=repairnow@gmail.com
GMAIL_PASS=xxxx-xxxx-xxxx-xxxx

# ─── Firebase (for Push Notifications) ────────────────────────────────────────
# Paste the entire JSON from Firebase Console → Project Settings → Service Accounts
# → Generate new private key (download JSON, paste contents here as one line)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
