# ─── Repair Now — Root .gitignore ────────────────────────────────────────────
# Covers the entire monorepo workspace: backend, client-rn, partner-rn

# ─── Node.js ─────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log
yarn-error.log
.yarn/

# ─── Environment Variables ────────────────────────────────────────────────────
# NEVER commit .env files — copy from .env.example to get started
**/.env
**/.env.local
**/.env.production
**/.env.development
**/.env.staging
**/.env.test
# .env.example IS committed (it's the safe template, no real secrets)
!**/.env.example

# ─── React Native ────────────────────────────────────────────────────────────
*.keystore
!debug.keystore
android/build/
android/app/build/
android/.gradle/
android/local.properties
ios/build/
ios/Pods/
DerivedData/
.metro-health-check*
.metro_cache/

# ─── TypeScript ──────────────────────────────────────────────────────────────
*.tsbuildinfo

# ─── OS Artifacts ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Editor ──────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ─── Test Coverage ───────────────────────────────────────────────────────────
coverage/
